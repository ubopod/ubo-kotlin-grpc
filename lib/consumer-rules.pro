# Consumer ProGuard rules for ubo-kotlin-grpc.
# Generated proto messages and gRPC stubs use reflection; keep them.
-keep class com.google.protobuf.** { *; }
-keep class io.grpc.** { *; }
-keep class store.v1.** { *; }
-keep class ubo.v1.** { *; }
-keep class secrets.v1.** { *; }
-keep class package_info.v1.** { *; }
